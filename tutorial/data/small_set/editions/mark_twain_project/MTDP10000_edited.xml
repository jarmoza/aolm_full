          </app>
        </p>
        <quote rend="blockquote">
          <l rend="center">
LADIES AND CHILDREN NOT

            <anchor type="app" xml:id="kg0081"/>
ADMITTED.

            <app from="kg0081" n="195.7 (184.12)" type="e" xml:id="kf0081">
