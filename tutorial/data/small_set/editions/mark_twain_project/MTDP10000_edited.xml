Arkansaw!”

          <app from="kg0079" n="195.6–9 (184.10–185.3)" type="e" xml:id="kf0079">
            <lem wit="A">Then . . . Arkansaw!”</lem>
            <rdg wit="MS2">Then . . . Arkansas!”</rdg>
            <rdg wit="Cent">
              <note place="inline" resp="MTP" type="ed" xml:id="uma011">not in</note>
            </rdg>
          </app>
        </p>
