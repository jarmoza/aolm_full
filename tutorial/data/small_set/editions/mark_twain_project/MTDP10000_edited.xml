            <rdg wit="A Cent">’deed</rdg>
          </app>
she has. She run off in de night,

          <anchor type="app" xml:id="pr2789"/>
some time

          <app from="pr2789" n="151.22 (478.5)" type="hc" xml:id="la4545">
            <lem wit="MS1b Cent">some time</lem>
            <rdg wit="A">sometime</rdg>
          </app>
—nobody don’t know

          <anchor type="alt" xml:id="tg1573"/>
jis’

          <ptr target="#l11146" type="alt" xml:id="te1573"/>
when—run off to

          <anchor type="app" xml:id="pr2790"/>
git

          <app from="pr2790" n="151.22 (478.8)" type="hc" xml:id="la4546">
            <lem wit="MS1b,A">git</lem>
            <rdg wit="Cent">get</rdg>
          </app>
married to dat young Harney Shepherdson, you know—leastways, so dey

          <anchor type="app" xml:id="pr2791"/>
          <anchor type="alt" xml:id="tg1574"/>
’spec

          <ptr target="#l11148" type="alt" xml:id="te1574"/>
          <app from="pr2791" n="151.24 (478.11)" type="e" xml:id="la4547">
            <lem wit="A">’spec</lem>
            <rdg wit="MS1b">’speck</rdg>
            <rdg wit="Cent">’spec’</rdg>
          </app>
. De fambly foun’ it

          <anchor type="app" xml:id="pr2792"/>
out,

          <app from="pr2792" n="151.24 (478.12)" type="hc" xml:id="la4548">
            <lem wit="MS1b,A">out,</lem>
            <rdg wit="Cent">
out

              <hi rend="subscript">⁁</hi>
            </rdg>
          </app>
’bout

          <anchor type="app" xml:id="pr2793"/>
half

          <app from="pr2793" n="151.24 (478.12–13)" type="e" xml:id="la4549">
            <lem wit="A Cent">half</lem>
            <rdg wit="MS1b">a half</rdg>
          </app>
an hour

          <anchor type="app" xml:id="pr2794"/>
ago—

          <app from="pr2794" n="151.24 (478.13)" type="hc" xml:id="la4550">
            <lem wit="MS1b,A">ago—</lem>
            <rdg wit="Cent">ago,—</rdg>
          </app>
          <anchor type="app" xml:id="pr2795"/>
maybe

          <app from="pr2795" n="151.24 (478.13)" type="hc" xml:id="la4551">
            <lem wit="MS1b,A">maybe</lem>
            <rdg wit="Cent">may be</rdg>
          </app>
a little

          <anchor type="app" xml:id="pr2796"/>
          <anchor type="alt" xml:id="tg1575"/>
mo’

          <app from="pr2796" n="151.25 (478.14)" type="hc" xml:id="la4552">
            <lem wit="MS1b,A">mo’</lem>
            <rdg wit="Cent">mo’,</rdg>
          </app>
          <ptr target="#l11150" type="alt" xml:id="te1575"/>
—

          <anchor type="app" xml:id="prn800"/>
          <anchor type="alt" xml:id="tg1576"/>
en

          <ptr target="#l11152" type="alt" xml:id="te1576"/>
          <app from="prn800" n="151.25 (478.14)" type="hc" xml:id="lan556">
            <lem wit="MS1b">en</lem>
            <rdg wit="A Cent">en’</rdg>
          </app>
I

          <hi rend="italic">tell</hi>
you dey warn’t no time los’. Sich another hurryin’ up guns

          <anchor type="alt" xml:id="tg1577"/>
en

          <ptr target="#l11154" type="alt" xml:id="te1577"/>
          <anchor type="app" xml:id="pr2798"/>
hosses

          <app from="pr2798" n="151.26 (479.1)" type="hc" xml:id="la4554">
            <lem wit="MS1b,A">hosses</lem>
            <rdg wit="Cent">horses</rdg>
          </app>
          <hi rend="italic">you</hi>
never see! De women folks has gone for to stir up de

          <anchor type="alt" xml:id="tg1578"/>
relations, en

          <ptr target="#l11156" type="alt" xml:id="te1578"/>
          <anchor type="app" xml:id="pr2799"/>
          <anchor type="alt" xml:id="tg1579"/>
ole

          <ptr target="#l11158" type="alt" xml:id="te1579"/>
          <app from="pr2799" n="151.27 (479.5)" type="hc" xml:id="la4555">
            <lem wit="MS1b,A">ole</lem>
            <rdg wit="Cent">old</rdg>
          </app>
          <anchor type="app" xml:id="pr2800"/>
          <anchor type="alt" xml:id="tg1580"/>
mars

          <ptr target="#l11160" type="alt" xml:id="te1580"/>
          <app from="pr2800" n="151.27 (479.5)" type="e" xml:id="la4556">
            <lem wit="C">mars</lem>
            <rdg wit="MS1b">Mars.</rdg>
            <rdg wit="A Cent">Mars</rdg>
          </app>
Saul

          <anchor type="alt" xml:id="tg1581"/>
en de

          <ptr target="#l11162" type="alt" xml:id="te1581"/>
boys tuck dey guns

          <anchor type="alt" xml:id="tg1582"/>
en rode

          <ptr target="#l11164" type="alt" xml:id="te1582"/>
          <anchor type="app" xml:id="pr2801"/>
up

          <app from="pr2801" n="151.28 (479.6–7)" type="e" xml:id="la4557">
